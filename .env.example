# Copy to .env with:  scripts/init_env.sh   (it fills in the generated secrets below)
# .env is git-ignored. Never commit it or the service-account key.

# --- Google Cloud / BigQuery (sandbox: no billing account linked) ---
GCP_PROJECT_ID=fmi-pipeline
BQ_LOCATION=europe-north1
BQ_RAW_DATASET=fmi_raw
BQ_DAILY_DATASET=fmi_daily
BQ_LONGTERM_DATASET=fmi_longterm
# Service-account key on the VM, outside the repository (chmod 600)
GCP_KEY_FILE=/home/ubuntu/secrets/gcp-key.json
# Per-query cap: a query that would process more than this fails instead of running (0 = no cap)
BQ_MAX_BYTES_BILLED=1000000000

# --- Pipeline ---
# Stations with their own long-term table: Helsinki Kaisaniemi, Tampere Härmälä,
# Jyväskylä lentoasema, Oulu lentoasema, Sodankylä Tähtelä
LONGTERM_STATIONS=100971,101124,101339,101786,101932
KAFKA_TOPIC=fmi-observations
# FMI open data allows 20 000 requests/day and 600 per 5 minutes. With ~200 weather stations,
# polling every 20 minutes uses ~15 000/day. Each poll returns the last 20 minutes (two 10-min steps).
POLL_INTERVAL_MINUTES=20
POLL_OFFSET_MINUTES=8
FMI_MAX_REQUESTS_PER_SECOND=1.5
# Hard stop: no more FMI requests after this many in one UTC day
FMI_DAILY_REQUEST_BUDGET=19000

# --- Airflow (generated by scripts/init_env.sh) ---
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
POSTGRES_PASSWORD=
